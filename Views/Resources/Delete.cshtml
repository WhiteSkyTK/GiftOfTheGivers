@model Gift_Of_The_Givers_Web_App.Models.Resource

@{
    ViewData["Title"] = "Delete Resource";
    Layout = "_DashboardLayout";
}

<h1>@ViewData["Title"]</h1>
<h3 class="text-danger">Are you sure you want to permanently delete this?</h3>
<hr />

<div class="card p-4">
    <h4>Resource Details</h4>
    <dl class="row mt-3">
        <dt class="col-sm-3">Resource Name</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ResourceName)</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>
    </dl>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="ResourceID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>