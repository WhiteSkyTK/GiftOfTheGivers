@{
    ViewData["Title"] = "About Us";
}

<section class="page-hero-section">
    <div class="container" data-aos="fade-up">
        <h1 class="display-4">About Our Foundation</h1>
        <p class="lead">Learn about our mission, principles, and the vision that drives us.</p>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row align-items-center" data-aos="fade-up">
            <div class="col-lg-6" data-aos="fade-right">
                <h2 class="display-5">A Beacon of Hope</h2>
                <p class="lead">The Gift of the Givers Foundation stands as a beacon of hope in times of crisis, dedicated to providing swift and effective aid to communities struck by natural disasters and emergencies in South Africa and beyond. </p>
                <p>Established in response to the growing need for organised relief efforts, we strive to make a tangible difference in the lives of those affected by adversity. </p>
            </div>
            <div class="col-lg-6" data-aos="fade-left" data-aos-delay="200">
                <img src="~/images/mission-image.jpg" class="img-fluid rounded shadow" alt="A volunteer handing supplies to a community member">
            </div>
        </div>
    </div>
</section>

<section class="section-padding" style="background-color: var(--light-accent-bg);">
    <div class="container text-center">
        <h2 class="mb-5" data-aos="fade-up">Our Core Principles</h2>
        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="principle-card h-100">
                    <div class="card-icon"><i class="bi bi-heart-fill"></i></div>
                    <h4>Compassion</h4>
                    <p>Every action is rooted in a deep sense of empathy and a desire to alleviate human suffering. </p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="principle-card h-100">
                    <div class="card-icon"><i class="bi bi-speedometer2"></i></div>
                    <h4>Efficiency</h4>
                    <p>We leverage technology and streamlined logistics to ensure aid reaches the most vulnerable as quickly as possible. </p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="principle-card h-100">
                    <div class="card-icon"><i class="bi bi-shield-check"></i></div>
                    <h4>Resilience</h4>
                    <p>Our work focuses not just on immediate relief, but on helping communities rebuild and strengthen for the future.  </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row align-items-center" data-aos="fade-up">
            <div class="col-lg-6 order-lg-2" data-aos="fade-left">
                <h2 class="display-5">An Innovative Platform</h2>
                <p class="lead">This web application represents a groundbreaking initiative to serve as a centralised hub for managing relief efforts, coordinating volunteers, and facilitating resource allocation. </p>
                <p>By seamlessly integrating technology and humanitarian aid, the project aims to enhance the effectiveness and reach of its relief operations, ultimately saving more lives and rebuilding communities with greater efficiency. </p>
            </div>
            <div class="col-lg-6 order-lg-1" data-aos="fade-right" data-aos-delay="200">
                <img src="~/images/platform-image.jpg" class="img-fluid rounded shadow" alt="A person using a laptop to coordinate logistics">
            </div>
        </div>
    </div>
</section>

<section class="section-padding" style="background-color: var(--light-accent-bg);">
    <div class="container text-center">
        <h2 class="mb-5" data-aos="fade-up">Meet Our Team</h2>
        <div class="row g-4">
            <div class="col-md-4 team-member" data-aos="fade-up" data-aos-delay="100">
                <img src="~/images/team-member-1.jpg" alt="Team Member 1">
                <h5 class="mt-3">Team Member Name</h5>
                <p class="text-muted">Role / Title</p>
            </div>
        </div>
    </div>
</section>