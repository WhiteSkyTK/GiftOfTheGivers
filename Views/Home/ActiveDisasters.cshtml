@{
    ViewData["Title"] = "Active Relief Efforts";
}

<section class="page-hero-section" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/active-disasters-hero.jpg');">
    <div class="container" data-aos="fade-up">
        <h1 class="display-4">@ViewData["Title"]</h1>
        <p class="lead">Here is where our teams are making a difference right now, thanks to your support.</p>
    </div>
</section>

<section class="section-padding" style="background-color: var(--white-color);">
    <div class="container text-center">
        <div class="row">
            <div class="col-md-4 summary-stat-item" data-aos="fade-up" data-aos-delay="100">
                <h2>12</h2>
                <p>Active Projects</p>
            </div>
            <div class="col-md-4 summary-stat-item" data-aos="fade-up" data-aos-delay="200">
                <h2>1,500+</h2>
                <p>Volunteers Deployed</p>
            </div>
            <div class="col-md-4 summary-stat-item" data-aos="fade-up" data-aos-delay="300">
                <h2>35</h2>
                <p>Communities Served</p>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <h2>Current Projects</h2>
            <p class="lead">Select a project to learn more or contribute directly to the cause.</p>
        </div>

        <div class="row g-4 mt-5">
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="card h-100">
                    <img src="~/images/eastern-cape-floods.jpg" class="card-img-top project-card-img" alt="Eastern Cape Flood Response">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Eastern Cape Flood Response</h5>
                        <p class="card-text text-muted"><i class="bi bi-geo-alt-fill"></i> Eastern Cape, South Africa</p>
                        <p class="card-text">Providing essential supplies like food, blankets, and clean water to families displaced by recent flooding.</p>
                        <div class="mt-auto">
                            <p class="mb-1">Funding Progress</p>
                            <div class="progress mb-3">
                                <div class="progress-bar" role="progressbar" style="width: 75%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">75%</div>
                            </div>
                            <a href="#" class="btn btn-primary">Donate to this Cause</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="card h-100">
                    <img src="~/images/gaza-aid.jpg" class="card-img-top project-card-img" alt="Gaza Humanitarian Aid">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Gaza Humanitarian Aid</h5>
                        <p class="card-text text-muted"><i class="bi bi-geo-alt-fill"></i> Gaza</p>
                        <p class="card-text">Delivering critical medical supplies, food, and fuel to hospitals and shelters in the region.</p>
                        <div class="mt-auto">
                            <p class="mb-1">Funding Progress</p>
                            <div class="progress mb-3">
                                <div class="progress-bar" role="progressbar" style="width: 60%;" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100">60%</div>
                            </div>
                            <a href="#" class="btn btn-primary">Donate to this Cause</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="section-padding" style="background-color: var(--white-color);">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <h2>Our Reach</h2>
            <p class="lead">Visualizing our active response projects across the continent.</p>
        </div>
        <div class="map-placeholder mt-4" data-aos="zoom-in">
            <p class="text-muted">An interactive map will be displayed here in a future update.</p>
        </div>
    </div>
</section>