@model IEnumerable<Gift_Of_The_Givers_Web_App.Models.DisasterIncident>

@{
    ViewData["Title"] = "Active Relief Efforts";
}

<section class="page-hero-section" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/active-disasters-hero.jpg');">
    <div class="container" data-aos="fade-up">
        <h1 class="display-4">@ViewData["Title"]</h1>
        <p class="lead">Here is where our teams are making a difference right now, thanks to your support.</p>
    </div>
</section>

<section class="section-padding" style="background-color: var(--white-color);">
    <div class="container text-center">
        <div class="row">
            <div class="col-md-4 summary-stat-item" data-aos="fade-up" data-aos-delay="100">
                <h2>@Model.Count()</h2>
                <p>Active Projects</p>
            </div>
            <div class="col-md-4 summary-stat-item" data-aos="fade-up" data-aos-delay="200">
                <h2>1,500+</h2>
                <p>Volunteers Deployed</p>
            </div>
            <div class="col-md-4 summary-stat-item" data-aos="fade-up" data-aos-delay="300">
                <h2>35</h2>
                <p>Communities Served</p>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <h2>Current Projects</h2>
            <p class="lead">Select a project to learn more or contribute directly to the cause.</p>
        </div>

        <div class="row g-4 mt-5">
            @foreach (var incident in Model)
            {
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="card h-100">
                        <img src="@(string.IsNullOrEmpty(incident.ImageUrl) ? "/images/placeholder.jpg" : incident.ImageUrl)" class="card-img-top project-card-img" alt="@incident.Title">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@incident.Title</h5>
                            <p class="card-text text-muted"><i class="bi bi-geo-alt-fill"></i> @incident.Location</p>
                            <p class="card-text">@incident.Description</p>
                            <div class="mt-auto">
                                <p class="mb-1">Funding Progress (@incident.CurrentFunds.ToString("C") / @incident.FundingGoal.ToString("C"))</p>
                                <div class="progress mb-3">
                                    @{
                                        var progressPercent = (incident.FundingGoal > 0) ? (incident.CurrentFunds / incident.FundingGoal) * 100 : 0;
                                    }
                                    <div class="progress-bar" role="progressbar" style="width: @progressPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%;" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100">@progressPercent.ToString("0")%</div>
                                </div>
                                <a asp-action="IncidentDetails" asp-route-incidentId="@incident.IncidentID" class="btn btn-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="section-padding" style="background-color: var(--white-color);">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <h2>Our Reach</h2>
            <p class="lead">Visualizing our active response projects across the continent.</p>
        </div>
        <div class="map-placeholder mt-4" data-aos="zoom-in">
            <p class="text-muted">An interactive map will be displayed here in a future update.</p>
        </div>
    </div>
</section>