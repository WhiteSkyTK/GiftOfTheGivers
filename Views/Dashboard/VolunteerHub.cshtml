@{
    ViewData["Title"] = "Volunteer Hub";
}

<div class="container my-5" data-aos="fade-up">
    <h1 class="display-4">@ViewData["Title"]</h1>
    <p class="lead">Find opportunities to contribute your time and skills to active relief projects.</p>
    <hr />

    <div class="alert alert-info">
        Active volunteer projects will be listed here once this section is connected to the database.
    </div>

    <div class="card mt-3" data-aos="fade-up" data-aos-delay="200">
        <div class="card-body">
            <h5 class="card-title">Eastern Cape Flood Relief</h5>
            <p class="card-text">We need volunteers to help with distributing food parcels and blankets.</p>
            <a href="#" class="btn btn-primary">View Details & Sign Up</a>
        </div>
    </div>
</div>