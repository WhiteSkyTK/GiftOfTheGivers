@using Microsoft.AspNetCore.Identity
@model Gift_Of_The_Givers_Web_App.ViewModels.VolunteerHubViewModel
@inject UserManager<ApplicationUser> UserManager

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Volunteer Hub";
}

<div data-aos="fade-up">
    <h1>@ViewData["Title"]</h1>
    <partial name="_StatusMessage" model="@(TempData["SuccessMessage"] as string)" />
</div>

@if (User.IsInRole("Volunteer"))
{
    <p class="lead">View your active assignments and find new opportunities to contribute.</p>
}
else
{
    <div class="card mt-4" data-aos="fade-up">
        <div class="card-body text-center p-5">
            <h3>Become a Volunteer</h3>
            <p class="lead my-3">Join our team of dedicated volunteers and make a real impact in communities across the nation. Submit your application to get started.</p>
            @{
                var currentUser = await UserManager.GetUserAsync(User);
                if (currentUser.VolunteerStatus == "Pending")
                {
                    <div class="alert alert-info">Your application is currently pending review by an administrator.</div>
                }
                else
                {
                    <form asp-action="ApplyToBeVolunteer" method="post">
                        <button type="submit" class="btn btn-primary btn-lg">Apply Now</button>
                    </form>
                }
            }
        </div>
    </div>
}
<div class="filter-bar mt-4" data-aos="fade-up" data-aos-delay="100">
    <form asp-action="VolunteerHub" method="get" class="row g-3 align-items-end">
        <div class="col-md-6">
            <label asp-for="SearchQuery" class="form-label fw-bold">Search by Keyword</label>
            <input asp-for="SearchQuery" class="form-control" placeholder="e.g., Flood Relief, Medical Aid...">
        </div>
        <div class="col-md-4">
            <label asp-for="SelectedLocation" class="form-label fw-bold">Location</label>
            <select asp-for="SelectedLocation" asp-items="@Model.Locations" class="form-select">
                <option value="">All Locations</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </form>
</div>

<div class="mt-5" data-aos="fade-up" data-aos-delay="200">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Your Active Assignments</h3>
        <a asp-action="MyAssignments" class="btn btn-outline-primary">View All My Assignments</a>
    </div>

    @if (!Model.MyAssignments.Any())
    {
        <p>You are not currently signed up for any assignments.</p>
    }
    else
    {
        var nextAssignment = Model.MyAssignments.OrderBy(a => a.IncidentDate).First();
        <div class="card active-assignment-card">
            <div class="card-body">
                <h5 class="card-title">Next Up: @nextAssignment.Title</h5>
                <p class="card-text text-muted">Location: @nextAssignment.Location</p>
            </div>
        </div>
    }
</div>


<div class="mt-5" data-aos="fade-up" data-aos-delay="300">
    <h3 class="mb-3">Available Opportunities</h3>
    @if (!Model.AvailableOpportunities.Any())
    {
        <div class="alert alert-info">There are no new volunteer opportunities matching your search. Please check back later.</div>
    }
    else
    {
        @foreach (var opportunity in Model.AvailableOpportunities)
        {
            <div class="card opportunity-card mb-3">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-9">
                            <h5 class="card-title">@opportunity.Title</h5>
                            <div class="card-meta">
                                <span class="me-3"><i class="bi bi-geo-alt-fill"></i>@opportunity.Location</span>
                                <span class="me-3"><i class="bi bi-calendar-event-fill"></i>Posted: @opportunity.IncidentDate.ToShortDateString()</span>
                            </div>
                            <p class="card-text mt-2">@opportunity.Description</p>
                        </div>
                        <div class="col-md-3 text-md-end mt-3 mt-md-0">
                            <form asp-action="SignUpForIncident" method="post">
                                <input type="hidden" name="incidentId" value="@opportunity.IncidentID" />
                                <a asp-action="ProjectDetails" asp-route-incidentId="@opportunity.IncidentID" class="btn btn-primary">View & Sign Up for Tasks</a>
                                <!--button type="submit" class="btn btn-primary">Sign Up</button>-->
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>