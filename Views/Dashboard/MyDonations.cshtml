@model IEnumerable<Gift_Of_The_Givers_Web_App.Models.Donation>

@{
    ViewData["Title"] = "My Donation History";
    Layout = "_DashboardLayout";
}

<div data-aos="fade-up">
    <h1>@ViewData["Title"]</h1>
    <p class="lead">A record of your generous contributions. Thank you for your support!</p>
</div>

<div class="card p-4 mt-4" data-aos="fade-up" data-aos-delay="100">
    @if (!Model.Any())
    {
        <div class="alert alert-info">You have not made any donations yet.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Project / Fund</th>
                    <th>Type</th>
                    <th>Amount / Item</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var donation in Model)
                {
                    <tr>
                        <td>@(donation.DisasterIncident?.Title ?? "General Fund")</td>
                        <td>@(donation.IsMonetary ? "Monetary" : "Resource")</td>
                        <td>
                            @if (donation.IsMonetary)
                            {
                                @donation.Amount?.ToString("C")
                            }
                            else
                            {
                                @($"{donation.Quantity}x {donation.Resource?.ResourceName}")
                            }
                        </td>
                        <td>@donation.DonationDate.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>