<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Simple styles for the sidebar layout */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 280px;
            padding: 1rem;
            background-color: #343a40; /* Dark background */
            color: #fff;
        }

            .sidebar .nav-link {
                color: #adb5bd;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    color: #fff;
                }

        .main-content {
            margin-left: 280px; /* Offset content by sidebar width */
            padding: 2rem;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h3 class="text-white mb-4">Dashboard</h3>
        <ul class="nav nav-pills flex-column">
            <li class="nav-item mb-2">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard Home</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person-circle"></i> My Profile</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link" asp-controller="Dashboard" asp-action="MyIncidents"><i class="bi bi-list-task"></i> My Incidents</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link" asp-controller="Dashboard" asp-action="ReportIncident"><i class="bi bi-exclamation-triangle"></i> Report Incident</a>
            </li>

            @if (User.IsInRole("GeneralUser"))
            {
                <li class="nav-item mb-2">
                    <a class="nav-link" asp-controller="Dashboard" asp-action="VolunteerApplication"><i class="bi bi-file-earmark-person"></i> My Volunteer Application</a>
                </li>
            }

            @if (User.IsInRole("Admin") || User.IsInRole("Volunteer"))
            {
                <li class="nav-item mb-2">
                    <a class="nav-link" asp-controller="Dashboard" asp-action="VolunteerHub"><i class="bi bi-people-fill"></i> Volunteer Hub</a>
                </li>
            }

            @if (User.IsInRole("Admin"))
            {
                <li class="nav-item mb-2">
                    <a class="nav-link text-warning" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-lock-fill"></i> Admin Panel</a>
                </li>
            }

            <li class="nav-item mt-auto">
                <partial name="_LoginPartial" />
            </li>
        </ul>
    </div>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>