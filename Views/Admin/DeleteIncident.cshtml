@model Gift_Of_The_Givers_Web_App.Models.DisasterIncident
@{
    ViewData["Title"] = "Delete Incident";
    Layout = "_DashboardLayout";
}

<h1>@ViewData["Title"]</h1>
<h3 class="text-danger">Are you sure you want to delete this?</h3>
<div>
    <h4>Incident: @Model.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.Location</dd>
    </dl>

    <form asp-action="DeleteIncidentConfirmed" method="post">
        <input type="hidden" name="incidentId" value="@Model.IncidentID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="ManageIncidents">Back to List</a>
    </form>
</div>