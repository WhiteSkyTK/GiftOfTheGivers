@model Gift_Of_The_Givers_Web_App.ViewModels.AdminIncidentDetailsViewModel
@{
    ViewData["Title"] = "Incident Details";
    Layout = "_DashboardLayout";
}

<h1>@Model.Incident.Title</h1>
<hr class="my-4" />

<div class="row">
    <div class="col-md-6">
        <h4>Existing Volunteer Tasks</h4>
        @if (Model.Incident.Tasks != null && Model.Incident.Tasks.Any())
        {
            <ul class="list-group">
                @foreach (var task in Model.Incident.Tasks)
                {
                    <li class="list-group-item">@task.Title (@task.TaskDate.ToShortDateString())</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No tasks created yet.</p>
        }
    </div>
    <div class="col-md-6">
        <h4>Add a New Task</h4>
        <form asp-action="AddTaskToIncident" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="NewTask.DisasterIncidentID" type="hidden" />

            <div class="mb-3">
                <label asp-for="NewTask.Title" class="form-label"></label>
                <input asp-for="NewTask.Title" class="form-control" />
                <span asp-validation-for="NewTask.Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewTask.TaskDate" class="form-label"></label>
                <input asp-for="NewTask.TaskDate" type="date" class="form-control" />
                <span asp-validation-for="NewTask.TaskDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewTask.Description" class="form-label"></label>
                <textarea asp-for="NewTask.Description" class="form-control" rows="3"></textarea>
            </div>
            <button type="submit" class="btn btn-secondary">Add Task</button>
        </form>
    </div>
</div>