@model Gift_Of_The_Givers_Web_App.Models.DisasterIncident
@{
    ViewData["Title"] = "Incident Details";
    Layout = "_DashboardLayout";
}

<h1>@Model.Title</h1>
<p class="text-muted">Submitted by: @Model.ApplicationUser?.Email on @Model.IncidentDate.ToShortDateString()</p>
<hr />

<div class="row">
    <div class="col-md-7">
        <h3>Details</h3>
        <dl class="row">
            <dt class="col-sm-4">Location</dt>
            <dd class="col-sm-8">@Model.Location</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@Model.Status</dd>

            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8">@Model.Description</dd>
        </dl>

        @if (Model.Status == "Pending Verification")
        {
            <form asp-action="ApproveIncident" method="post" class="mt-4">
                <input type="hidden" name="incidentId" value="@Model.IncidentID" />
                <button type="submit" class="btn btn-success"><i class="bi bi-check-circle-fill"></i> Approve Incident</button>
            </form>
        }
    </div>
    <div class="col-md-5">
        <h3>Image</h3>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="@Model.Title">
        }
        else
        {
            <p class="text-muted">No image was submitted for this incident.</p>
        }
    </div>
</div>