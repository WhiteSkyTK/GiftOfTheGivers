@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="container section-padding">
    <h2 class="display-5" data-aos="fade-up">Manage Your Account</h2>
    <hr />
    <div class="row mt-4">
        <div class="col-md-3" data-aos="fade-right">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9" data-aos="fade-left" data-aos-delay="100">
            <div class="card p-4">
                <partial name="_StatusMessage" for="StatusMessage" />
                <form id="profile-form" method="post">
                    <div class="row">
                        <div class="col-md-8">
                            <h4>@ViewData["Title"]</h4>
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="Username" class="form-control" placeholder="Please choose your username." disabled />
                                <label asp-for="Username" class="form-label"></label>
                            </div>

                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.FirstName" class="form-control" placeholder="Please enter your first name." />
                                        <label asp-for="Input.FirstName" class="form-label"></label>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.LastName" class="form-control" placeholder="Please enter your last name." />
                                        <label asp-for="Input.LastName" class="form-label"></label>
                                    </div>
                                </div>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Please enter your phone number." />
                                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                            </div>
                            <button id="update-profile-button" type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="profile-picture-container">
                                <img src="~/images/profile-placeholder.png" class="profile-picture" alt="Profile Picture">
                                <button type="button" class="btn btn-primary btn-edit-photo"><i class="bi bi-camera-fill"></i></button>
                            </div>
                            <p class="text-muted small">Profile picture functionality can be added later.</p>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}