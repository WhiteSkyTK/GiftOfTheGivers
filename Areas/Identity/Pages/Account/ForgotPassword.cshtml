@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
    // This page will not use the main layout
    Layout = null;
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<div class="auth-split-screen">
    <div class="auth-form-half">
        <div class="container" style="max-width: 500px;">
            <div class="text-center mb-4">
                <a asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Logo" style="max-height: 60px;">
                </a>
                <h2 class="mt-3">@ViewData["Title"]</h2>
                <p class="text-muted">Enter your email and we'll send you a link to reset your password.</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label"></label>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Reset Password</button>
            </form>
            <div class="text-center mt-4">
                <a asp-page="./Login">Back to Login</a>
            </div>
        </div>
    </div>

    <div class="auth-image-half">
        <div data-aos="fade-in" data-aos-delay="200">
            <img src="~/images/logo.png" alt="Logo">
            <h1 class="display-4 mt-3">Let's Get You Back In</h1>
            <p class="lead mt-3">"Restoring access for those who help us restore dignity."</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}