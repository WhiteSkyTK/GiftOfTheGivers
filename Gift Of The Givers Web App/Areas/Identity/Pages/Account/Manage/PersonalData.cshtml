@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="container section-padding">
    <h2 class="display-5" data-aos="fade-up">Manage Your Account</h2>
    <hr />
    <div class="row mt-4">
        <div class="col-md-3" data-aos="fade-right">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9" data-aos="fade-left" data-aos-delay="100">
            <div class="card p-4">
                <h4>@ViewData["Title"]</h4>
                <p class="mt-3">Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
                <form id="download-data" asp-page="DownloadPersonalData" method="post" class="mt-2">
                    <button class="btn btn-primary" type="submit">Download Your Data</button>
                </form>

                <div class="danger-zone mt-5">
                    <div class="danger-zone-header">
                        <h5>Danger Zone</h5>
                    </div>
                    <div class="p-4">
                        <p>
                            <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
                        </p>
                        <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Delete Account</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}