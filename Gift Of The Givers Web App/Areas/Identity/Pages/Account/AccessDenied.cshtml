@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    // This page will not use the main layout
    Layout = null;
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<div class="auth-split-screen">
    <div class="auth-form-half">
        <div class="container text-center" style="max-width: 500px;">
            <i class="bi bi-lock-fill" style="font-size: 4rem; color: var(--cambridge-blue);"></i>
            <h1 class="text-danger mt-3">@ViewData["Title"]</h1>
            <p class="lead text-danger">You do not have permission to view this resource.</p>
            <hr />
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-3">Return to Dashboard</a>
        </div>
    </div>

    <div class="auth-image-half">
        <div>
            <img src="~/images/logo.png" alt="Logo">
            <h1 class="display-4 mt-3">Secure Access</h1>
            <p class="lead mt-3">"Ensuring the right people have the right access to manage our relief efforts effectively."</p>
        </div>
    </div>
</div>