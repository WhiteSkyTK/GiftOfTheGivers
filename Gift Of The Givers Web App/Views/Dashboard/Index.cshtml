@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Dashboard";
}

<div data-aos="fade-up">
    <h1>Welcome, <span class="text-accent">@User.Identity?.Name</span>!</h1>

    @if (User.IsInRole("Admin") || User.IsInRole("Volunteer"))
    {
        <p class="lead">Manage your profile, report incidents, and find volunteer opportunities.</p>
    }
    else
    {
        <p class="lead">From here you can manage your profile or apply to become a volunteer.</p>
    }
</div>

@if (User.IsInRole("Admin") || User.IsInRole("Volunteer"))
{
    <div class="row g-4 mt-4">
        <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
            <div class="card dashboard-card text-center h-100 p-3">
                <div class="card-body">
                    <div class="card-icon"><i class="bi bi-exclamation-triangle"></i></div>
                    <h3>Report an Incident</h3>
                    <a asp-controller="Dashboard" asp-action="ReportIncident" class="btn btn-primary mt-auto">Go &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
            <div class="card dashboard-card text-center h-100 p-3">
                <div class="card-body">
                    <div class="card-icon"><i class="bi bi-people-fill"></i></div>
                    <h3>Volunteer Hub</h3>
                    <a asp-controller="Dashboard" asp-action="VolunteerHub" class="btn btn-primary mt-auto">Go &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
            <div class="card dashboard-card text-center h-100 p-3">
                <div class="card-body">
                    <div class="card-icon"><i class="bi bi-person-circle"></i></div>
                    <h3>My Profile</h3>
                    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-primary mt-auto">Go &rarr;</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card mt-4" data-aos="fade-up">
        <div class="card-body text-center p-5">
            <h3>Become a Volunteer</h3>
            <p class="lead my-3">Join our team of dedicated volunteers and make a real impact. View your application status or submit an application to get started.</p>
            <a asp-controller="Dashboard" asp-action="VolunteerApplication" class="btn btn-primary btn-lg">My Volunteer Application</a>
        </div>
    </div>
}