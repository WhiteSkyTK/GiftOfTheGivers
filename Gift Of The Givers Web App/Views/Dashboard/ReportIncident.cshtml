@model Gift_Of_The_Givers_Web_App.ViewModels.ReportIncidentViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Report an Incident";
}

<div data-aos="fade-up">
    <h1>@ViewData["Title"]</h1>
    <p class="lead">Submit details about a natural disaster or emergency in your area.</p>
    <hr />

    <div class="card p-4 mt-4">
        <form asp-action="ReportIncident" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="e.g., KZN Flooding Support" />
            </div>
            <div class="mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" placeholder="e.g., Durban, KwaZulu-Natal" />
            </div>
            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="6"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Submit Report</button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}