@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Become a Volunteer";
    var currentUser = await UserManager.GetUserAsync(User);
}

<partial name="_StatusMessage" model="@(TempData["SuccessMessage"] as string)" />

<div class="card mt-4" data-aos="fade-up">
    <div class="card-body text-center p-5">

        @switch (currentUser.VolunteerStatus)
        {
            case "Pending":
                <i class="bi bi-clock-history" style="font-size: 4rem; color: var(--cambridge-blue);"></i>
                <h2 class="mt-3">Application Pending</h2>
                <p class="lead my-3">Your application is currently under review by an administrator. Thank you for your patience.</p>
                break;

            case "Approved":
                <i class="bi bi-check-circle-fill" style="font-size: 4rem; color: #198754;"></i>
                <h2 class="mt-3">Application Approved!</h2>
                <p class="lead my-3">Welcome to the team! You now have full access to the Volunteer Hub.</p>
                <a asp-action="VolunteerHub" class="btn btn-primary btn-lg">Go to Volunteer Hub</a>
                break;

            default: // "Not Applied" or anything else
                     <h2 class="mt-3">Join Our Volunteer Team</h2>
                     <p class="lead my-3">Make a real impact in communities across the nation by submitting your application to become a volunteer.</p>
                     <form asp-action="SubmitVolunteerApplication" method="post">
                         <button type="submit" class="btn btn-primary btn-lg">Apply Now</button>
                     </form>
                break;
        }

    </div>
</div>