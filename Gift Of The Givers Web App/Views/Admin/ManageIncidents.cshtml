@model IEnumerable<Gift_Of_The_Givers_Web_App.Models.DisasterIncident>

@{
    ViewData["Title"] = "Manage Incidents";
    Layout = "_DashboardLayout";
}

<h1>@ViewData["Title"]</h1>
<p>Review and approve new incident reports submitted by users.</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Title</th>
            <th>Location</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    <tbody>
        @if (!Model.Any())
        {
            <div class="alert alert-info">There are no incidents in the system yet.</div>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Location</td>
                <td><span class="badge bg-warning text-dark">@item.Status</span></td>
                <td>
                    <a asp-action="IncidentDetails" asp-route-incidentId="@item.IncidentID" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="EditIncident" asp-route-incidentId="@item.IncidentID" class="btn btn-sm btn-warning">Edit</a>

                    <form asp-action="DeleteIncidentConfirmed" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
                        <input type="hidden" name="incidentId" value="@item.IncidentID" />
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>